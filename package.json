{
  "name": "after-effects-mcp",
  "version": "1.0.0",
  "description": "MCP server for Adobe After Effects",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --packages=external && node -e \"require('node:fs').cpSync('src/scripts','build/scripts',{recursive:true})\"",
    "start": "node build/index.js",
    "install-bridge": "node install-bridge.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "esbuild": "^0.27.4",
    "typescript": "^5.2.2"
  }
}
